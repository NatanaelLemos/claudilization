# Optional public origin used in generated install and player links.
# CLAUDILIZATION_PUBLIC_URL=https://example.com

# Optional persistent Postgres store. Without it, state is written under data/.
# DATABASE_URL=<postgres connection string>

# Optional runtime overrides.
# PORT=8787
# CLAUDILIZATION_HOST=127.0.0.1
# CLAUDILIZATION_BASE_PATH=/apps/projects/claudilization
# CLAUDILIZATION_DATA=data/world
# CLAUDILIZATION_SEED=42
