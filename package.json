{
  "name": "claudilization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A living island world powered by your Claude Code usage.",
  "repository": {
    "type": "git",
    "url": "https://github.com/NatanaelLemos/claudilization.git"
  },
  "homepage": "https://claudilization.com",
  "bugs": {
    "url": "https://github.com/NatanaelLemos/claudilization/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "clawdia": {
    "displayName": "Claudilization",
    "icon": "🏝️"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/main.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scenario": "playwright test",
    "benchmark:dense": "tsx scripts/dense-building-benchmark.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run typecheck",
    "verify:release": "npm test && npm run typecheck && npm run build && npm run test:scenario"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "camera-controls": "^2.9.0",
    "pg": "^8.22.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.166.0",
    "tsx": "^4.16.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/three": "^0.166.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
